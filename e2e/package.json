{
  "name": "@snag/e2e",
  "private": true,
  "type": "module",
  "description": "Browser E2E suites. Needs the server (8080), widget demo host (5173) and dashboard (3000) running.",
  "scripts": {
    "widget": "mkdir -p screenshots && node widget.mjs",
    "dashboard": "mkdir -p screenshots && node dashboard.mjs",
    "users": "mkdir -p screenshots && node users.mjs",
    "teams": "mkdir -p screenshots && node teams.mjs",
    "regressions": "node state-regressions.mjs",
    "website": "node website.mjs",
    "performance": "node performance.mjs",
    "accessibility": "node accessibility.mjs"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright-core": "1.65.1"
  }
}
