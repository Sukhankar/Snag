POSTGRES_PASSWORD=change-me

# The ultimate user (Owner): full access, manages users, roles and permissions.
# Created on the first start only. Sign in with these, then change the password under My account.
SNAG_OWNER_NAME=Owner
SNAG_OWNER_EMAIL=owner@example.com
SNAG_OWNER_PASSWORD=change-me-now-please

# Optional full-access token for scripts/automation (>= 24 chars). Leave empty if unused.
SNAG_ADMIN_TOKEN=

# Master key for signed reporter identities (users recognised across browsers and devices).
# Server-only, never stored in the database; at least 32 characters: openssl rand -base64 48
# Changing it invalidates every project's identity secret. Leave empty to disable the feature.
SNAG_IDENTITY_KEY=

# Secure cookies work on http://localhost; set false only for plain-http LAN hosts
COOKIE_SECURE=true

# Optional demo tenant for trying the widget
SNAG_DEMO_PROJECT_KEY=pk_demo_0000000000000000000000000000
SNAG_DEMO_ORIGINS=http://localhost:5173

# Ticket submissions per minute per project+IP (raise for load/smoke testing)
SNAG_CREATE_PER_MINUTE=10

# Public website (docker compose service "website").
# Use your real https address in production: enables HSTS, search indexing, sitemap and canonical URLs.
SITE_URL=http://localhost:4180
WEBSITE_PORT=4180
